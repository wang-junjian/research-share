# ---------------------------------------------------------------------------
# 云服务配置
#
# 这两项来自你创建应用时拿到的 publicConfig。两项缺任意一项，
# 服务会进入「演示模式」：用 data/sample-items.json 的示例数据渲染公开页面，
# 后台管理不可用，所有写操作被丢弃。演示模式适合先看界面。
# ---------------------------------------------------------------------------
CLOUD_ENDPOINT=
CLOUD_PUBLISHABLE_KEY=

# 登录跳转中转地址。用云服务的默认值即可，一般不用改。
CLOUD_OAUTH_RELAY=https://www.workbuddy.cn/v2/as/genie-baas/oauth

# ---------------------------------------------------------------------------
# 站点信息
# ---------------------------------------------------------------------------

# 站点的**对外可访问**地址。og:url / canonical / og:image 都用它拼。
# 必须是绝对 URL，且必须是别人能访问到的地址 —— 写 127.0.0.1 的话，
# 微信抓取时会拿不到封面图（分享卡片没有缩略图）。
# 本地调试可以保留默认值，只是分享预览会失效。
SITE_URL=http://127.0.0.1:3000

SITE_NAME=研究成果
SITE_DESC=持续更新的研究成果卡片：标题、概览与原文链接。

# ---------------------------------------------------------------------------
# 分享码（可选，但发布到 WorkBuddy 域名时几乎必须）
#
# 平台的发布域名前置了一道防爬闸门：请求必须带 ?sharecode=<码> 才放行，通过后
# 种一个 30 天 cookie，同浏览器内后续路径都正常。不带参数时，外部访客（包括
# 微信的链接预览抓取器）看到的是平台拦截页「链接不完整」，而不是你的页面 ——
# 连 /og/:id.png 封面图、/api/* 一起被拦，因为闸门在应用之前。
#
# 填上这个码，下面这些对外地址会自动带上它：
#   · 页面 canonical / og:url / og:image（微信抓取器不会自己补参数）
#   · 详情页「复制链接」与海报二维码（data-url 是它们的唯一来源）
#   · 后台编辑弹层里展示的托管地址
# 站内相对链接与埋点路径不受影响。留空即当作没有闸门（本地开发、别人的 clone）。
# 码不是密码 —— 它本来就是发给外部读者的，随页面源码一起公开无妨。
# ---------------------------------------------------------------------------
SITE_SHARE_CODE=

# ---------------------------------------------------------------------------
# 顶栏外链（可选）
#
# 顶栏右侧的一个胶囊链接，指向同一位作者的另一款应用。它**不是成果条目**：
# 不进列表、不参与排序，因此不会随日期沉底；也不产生埋点（点击不计入原文跳转率）。
#
# 两项里缺任一项就整条不渲染 —— 留空即关闭，别人的 clone 不会继承你的链接。
# url 要写完整可用地址；若目标应用需要分享参数（如 ?sharecode=xxx）也必须带上，
# 否则对方打开会被拦（多数「链接不完整」的 403 都是漏了这个参数）。
# ---------------------------------------------------------------------------
SITE_LINK_URL=
SITE_LINK_TITLE=

PORT=3000

# ---------------------------------------------------------------------------
# 排障（可选）
# ---------------------------------------------------------------------------

# /__health 详情档的口令。不配时该地址只回 {ok, demo, uptimeSec} 三个字段；
# 配上后用 /__health?token=<这里的值> 才能看到 Node 版本、数据面域名解析结果、
# 代理变量键名 —— 排「整站 500、日志只有 fetch failed」时不用翻部署日志。
# 平时留空即关闭详情档；正在排障时临时配上，查完再清掉。
HEALTH_TOKEN=
